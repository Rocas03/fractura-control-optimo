#!/bin/sh
# Llama a Julia 1.11.4, la versión con que está fijado el Manifest del paquete.
# Con una versión más nueva, Pkg intenta resolver de nuevo el Manifest y sale a la red; con 1.11.4 las
# pruebas corren sin red. Si el binario está en otra ruta, se pasa en JULIA_BIN.
JULIA_BIN="${JULIA_BIN:-$HOME/.julia/juliaup/julia-1.11.4+0.aarch64.apple.darwin14/bin/julia}"
if [ ! -x "$JULIA_BIN" ]; then
  echo "jl: no está o no es ejecutable: $JULIA_BIN" >&2
  echo "jl: mide las versiones instaladas con 'juliaup status' y pasa la ruta en JULIA_BIN" >&2
  exit 2
fi
exec "$JULIA_BIN" "$@"
